# Copy this file to .env and fill in your real values.
# Required: Anthropic API key for the LangChain/LangGraph agents.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override the default model (defaults to claude-sonnet-4-20250514).
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: enable real Slack notifications via bot token.
# Set MCP_MODE=real to send real Slack messages instead of logging them.
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# MCP_MODE=real
